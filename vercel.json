{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/p",
      "destination": "/api/tx"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
